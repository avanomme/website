# Ignore git metadata and node_modules
.git
node_modules

# Exclude local virtualenvs and build artifacts
venv
.venv
flash_cards/.venv-tts
build
dist

# Large assets and source trees not required for frontend deployment
lib/graphviz
sounds

# Editor / OS files
.DS_Store
*.swp
*.swo

# temp and generated files
*.aux
*.fls
*.fdb_latexmk
temp.*

# Optional: do not upload tests/docs heavy folders
lib/**/tests
.claude

# Large project directories not needed for deployment
emsdk
MuseScore
MusePlay

# music_player - exclude large dependencies but keep core files
music_player/node_modules
music_player/soundfonts
music_player/musescore-player
music_player/verovio-reference-book.pdf

# Exclude large soundfont files everywhere
**/*.sf2
