# ========== VERCEL IGNORE ==========
# Only deploy essential web files

# Git
.git/
.gitignore
.gitattributes

# Node
node_modules/

# Python environments & cache
venv/
.venv/
__pycache__/
*.pyc
*.pyo

# Python files except server files
apps/**/*.py
scripts/**/*.py

# Large directories in root
external/
lib/
sounds/
cox_model/
cox7_clips/
cox8_clips/
build/
dist/
apps_previous/
cloned_voice_samples_elevenlabs/
cloned_voice_samples_xtts/

# All audio/video files
*.wav
*.mp3
*.mp4
*.ogg
*.flac
*.m4a

# Archives
*.zip
*.tar
*.tar.gz
*.tgz

# Logs and temp
*.log
temp*/
*.tmp

# Heavy flashcards directories
apps/flashcards/archive/
apps/flashcards/audio_cache/
apps/flashcards/audio_samples/
apps/flashcards/custom_models/
apps/flashcards/custom_voices/
apps/flashcards/voice_previews/
apps/flashcards/scripts/
apps/flashcards/.venv*/
apps/flashcards/docs/

# Heavy app directories
apps/**/node_modules/
apps/**/temp/
apps/**/cache/
apps/**/soundfonts/
apps/**/midi/
apps/**/timemaps/
apps/**/samples/
apps/**/recordings/
apps/**/data/
apps/**/clips/
apps/**/voices/
apps/**/models/

# Museplay heavy stuff
apps/museplay/

# Vercel internal
.vercel/

# Documentation (not needed for deploy)
*.md
!apps/flashcards/cards.md
!apps/flashcards/se_final/**/*.md
