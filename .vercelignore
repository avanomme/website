# Ignore git metadata and node_modules
.git
node_modules

# Exclude local virtualenvs and build artifacts
venv
.venv
apps/flashcards/.venv-tts
apps/flashcards/.venv-edge-tts
build
dist

# Large assets and source trees not required for deployment
lib/graphviz
sounds/
external/

# Large WAV files in root
*.wav

# Flashcards - exclude large audio caches and samples
apps/flashcards/voice_previews/
apps/flashcards/audio_samples/
# DO NOT exclude audio_cache - we need it for deployment
# apps/flashcards/audio_cache/

# Editor / OS files
.DS_Store
*.swp
*.swo

# temp and generated files
*.aux
*.fls
*.fdb_latexmk
temp.*

# Optional: do not upload tests/docs heavy folders
lib/**/tests
.claude

# Large project directories not needed for deployment
emsdk/
MuseScore/

# apps/player - exclude large dependencies but keep core files
apps/player/node_modules/

# apps/museplay - exclude large dependencies and temp files
apps/museplay/node_modules/
apps/museplay/temp/
apps/museplay/soundfonts/

# Python cache
__pycache__/
*.pyc

# Archived files
.archived/
