# ========== VERCEL IGNORE (MASTER CLEAN VERSION) ==========

# Git
.git/
.gitignore

# Node
node_modules/
apps/**/node_modules/

# Python
venv/
.venv/
*/__pycache__/
*.pyc

# Build / cache / temp
dist/
build/
*.log
temp*
*.tmp
*.zip
*.tar.gz
*.tgz

# Do NOT deploy local models, audio, or external assets
external/
lib/graphviz/
lib/
sounds/
cox_model/
cox7_clips/
cox8_clips/
cloned_voice_samples_elevenlabs/
cloned_voice_samples_xtts/
apps_previous/
build/

# Flashcards - ignore heavy data
apps/flashcards/audio_cache/
apps/flashcards/audio_samples/
apps/flashcards/.venv-tts/
apps/flashcards/.venv-edge-tts/
apps/flashcards/custom_models/
apps/flashcards/voice_previews/
apps/flashcards/archive/
apps/flashcards/scripts/
apps/flashcards/*.py

# Apps - ignore big app-specific content
apps/**/temp/
apps/**/cache/
apps/**/soundfonts/
apps/**/midi/
apps/**/timemaps/
apps/**/samples/
apps/**/recordings/
apps/**/data/
apps/**/clips/
apps/**/voices/
apps/**/models/

# Keep ONLY the necessary web assets:
#   - HTML, CSS, JS, WASM, JSON
# Everything else is ignored by default except files outside this ignore list.

# Ignore large media in root
/*.wav
/*.mp3

# Vercel files
.vercel