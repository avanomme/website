# Ignore git metadata and node_modules
.git
node_modules

# Exclude local virtualenvs and build artifacts
venv
.venv
apps/flashcards/.venv-tts
build
dist

# Large assets and source trees not required for frontend deployment
lib/graphviz
sounds
external/

# Editor / OS files
.DS_Store
*.swp
*.swo

# temp and generated files
*.aux
*.fls
*.fdb_latexmk
temp.*

# Optional: do not upload tests/docs heavy folders
lib/**/tests
.claude

# Large project directories not needed for deployment
emsdk
MuseScore
MusePlay

# apps/player - exclude large dependencies but keep core files, soundfonts, and scores
apps/player/node_modules
apps/player/musescore-player
apps/player/verovio-reference-book.pdf

# apps/museplay - exclude large dependencies
apps/museplay/node_modules
apps/museplay/temp/
