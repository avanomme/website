{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/log.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/cards.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/player/**",
      "use": "@vercel/static"
    },
    {
      "src": "apps/flashcards/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/apps/flashcards/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/apps/flashcards/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/log",
      "destination": "/api/log.py"
    },
    {
      "source": "/api/logs",
      "destination": "/api/log.py"
    },
    {
      "source": "/api/logs/stats",
      "destination": "/api/log.py"
    },
    {
      "source": "/api/cards/save",
      "destination": "/api/cards.py"
    },
    {
      "source": "/api/cards/list",
      "destination": "/api/cards.py"
    },
    {
      "source": "/api/cards/(.*)",
      "destination": "/api/cards.py"
    },
    {
      "source": "/music_player/(.*)",
      "destination": "/apps/player/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.py"
    }
  ]
}