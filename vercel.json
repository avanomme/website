{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,

  "functions": {
    "app.py": {
      "runtime": "@vercel/python@3.1"
    },
    "api/*.py": {
      "runtime": "@vercel/python@3.1"
    }
  },

  "headers": [
    {
      "source": "/apps/flashcards/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/apps/flashcards/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],

  "rewrites": [
    { "source": "/api/log", "destination": "/api/log.py" },
    { "source": "/api/logs", "destination": "/api/log.py" },
    { "source": "/api/logs/stats", "destination": "/api/log.py" },

    { "source": "/api/cards/save", "destination": "/api/cards.py" },
    { "source": "/api/cards/list", "destination": "/api/cards.py" },
    { "source": "/api/cards/(.*)", "destination": "/api/cards.py" },

    { "source": "/music_player/(.*)", "destination": "/apps/player/$1" },

    { "source": "/((?!apps|api|shared|_next).*)", "destination": "/app.py" }
  ]
}
