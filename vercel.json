{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/player/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/music_player/(.*)",
      "dest": "/apps/player/$1"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}